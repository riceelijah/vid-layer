{
  "name": "vidlayer",
  "version": "0.1.1",
  "description": "Let Claude watch videos: scene-aware keyframes, storyboards, and timestamped transcripts via a local MCP server.",
  "author": {
    "name": "Elijah Rice"
  },
  "repository": "https://github.com/riceelijah/vid-layer",
  "license": "MIT",
  "keywords": [
    "video",
    "mcp",
    "vision",
    "transcript",
    "ffmpeg"
  ],
  "mcpServers": {
    "vidlayer": {
      "command": "uvx",
      "args": [
        "--from",
        "${CLAUDE_PLUGIN_ROOT}",
        "--with",
        "mcp>=1.2",
        "vidlayer",
        "mcp"
      ]
    }
  }
}
